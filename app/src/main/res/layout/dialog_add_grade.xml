<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <EditText
            android:id="@+id/etDlgCourse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/grade_dlg_course"
            android:inputType="text" />

        <EditText
            android:id="@+id/etDlgCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/grade_dlg_code"
            android:inputType="text" />

        <EditText
            android:id="@+id/etDlgCredit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/grade_dlg_credit"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/grade_dlg_property"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spDlgProperty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/grade_dlg_semester"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spDlgSemester"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etDlgGrade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/grade_dlg_grade"
            android:inputType="text" />
    </LinearLayout>
</ScrollView>